# Server-side configuration. Copy to .env.local for local development
# (.env.local is git-ignored) and set the same variables in the Vercel project's
# environment settings (server-side, NOT exposed to the browser).
#
# Xano instance origin only: https://<instance-subdomain>.<cluster>.xano.io
# No path, port, query or trailing API group. API group paths are configured in
# src/lib/xano/groups.ts. Never prefix this with NEXT_PUBLIC_.
XANO_BASE_URL=

# This site's own origin, used to validate the Origin header of every
# state-changing request (CSRF defence). https in every deployed environment;
# http://localhost:3000 is accepted for local development only. It is never
# derived from the incoming Host header.
APP_ORIGIN=
